# Environment variables for the OrnoPlante Backend

# --- Database ---
# Connection URL for your MySQL database, used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:rootpassword@localhost:3306/Ornoplante"

# --- Security ---
# A secret key for signing JSON Web Tokens (JWT).
# Use a long, random string for production.
JWT_SECRET="your-super-secret-jwt-key"

# Initial password for the default admin user.
Admin_PW="a-strong-password-for-the-admin"

# --- Third-Party APIs ---
# API key for Google Gemini.
GEMINI_API_KEY="your-gemini-api-key"

# API key for PlantNet.
PLANTNET_API_KEY="your-plantnet-api-key"
